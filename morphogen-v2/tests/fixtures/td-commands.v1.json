{
  "_comment": "Golden cross-language contract for the Morphogen v2 TD -> app control plane (v1). Read by BOTH tests/tdContract.test.mjs (browser parser + gate in src/sync/tdCommand.ts) and ../tests/test_td_sync_contract.py (TD builders + pacer in td/morphogen_sync_commands.py). If you change either side's rules, update this file and both suites must still pass. Added 2026-10-23.",
  "version": 1,
  "built": [
    { "build": ["preset", "coral"], "raw": "{\"v\":1,\"cmd\":\"preset\",\"id\":\"coral\"}", "parsed": { "cmd": "preset", "id": "coral" } },
    { "build": ["preset", "  Mitosis "], "raw": "{\"v\":1,\"cmd\":\"preset\",\"id\":\"mitosis\"}", "parsed": { "cmd": "preset", "id": "mitosis" } },
    { "build": ["preset", "USKATE"], "raw": "{\"v\":1,\"cmd\":\"preset\",\"id\":\"uskate\"}", "parsed": { "cmd": "preset", "id": "uskate" } },
    { "build": ["preset_unknown", "nebula"], "raw": "{\"v\":1,\"cmd\":\"preset\",\"id\":\"nebula\"}", "parsed": { "cmd": "preset", "id": "nebula" } },
    { "build": ["ping", 1000], "raw": "{\"v\":1,\"cmd\":\"ping\",\"t\":1000}", "parsed": { "cmd": "ping", "t": 1000 } },
    { "build": ["ping", 1234.5], "raw": "{\"v\":1,\"cmd\":\"ping\",\"t\":1234.5}", "parsed": { "cmd": "ping", "t": 1234.5 } }
