    "{\"cmd\":\"preset\",\"id\":\"coral\"}",
    "{\"v\":1,\"cmd\":\"preset\",\"id\":\"co ral\"}",
    "[1,2,3]",
    "not json"
  ],
  "pong": { "ping_raw": "{\"v\":1,\"cmd\":\"ping\",\"t\":1000}", "reply": { "v": 1, "pong": "morphogen", "t": 1000 } },
  "gate": {
    "_comment": "Clock readings in ms fed one-by-one to a fresh 10/s burst-5 bucket; allow[i] is the expected verdict. Covers the burst, refill at 100 ms/token, a backwards clock that must not mint tokens, and a long idle capped at the burst.",
    "clock_ms": [0, 0, 0, 0, 0, 0, 50, 100, 100, 50, 250, 250, 250, 5000, 5000, 5000, 5000, 5000, 5000],
    "allow":    [true, true, true, true, true, false, false, true, false, false, true, false, false, true, true, true, true, true, false]
  }
